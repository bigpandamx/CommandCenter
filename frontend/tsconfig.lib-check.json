{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "../backend/types/**/*.d.ts",
    "src/lib/adminApiClient.ts",
    "src/lib/aegisSupportClient.ts",
    "src/lib/billingSummaryResolver.ts",
    "test/**/*.ts"
  ]
}
